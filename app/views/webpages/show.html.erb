

<h1> Webpage </h1>
<p>
  <strong>Url:</strong>
  <%= @webpage.url %>
</p>

<p>
  <strong>Rollout:</strong>
  <%= webpage_rollout_badge(@webpage) %>
</p>
<p class="rollout-note"><%= webpage_rollout_explanation(@webpage) %></p>

<% cache_links = webpage_cache_links(@webpage) %>
<p>
  <strong>Cache:</strong>
  <% if cache_links[:disabled] %>
    <span><%= cache_links[:warning] %></span>
  <% elsif cache_links[:active_cache_url].present? %>
    <%= link_to cache_links[:label], cache_links[:active_cache_url] %>
    | <%= operator_active_backend_badge(cache_links) %>
    <% cache_links[:secondary_links].each do |link| %>
      | <%= link_to link[:label], link[:url] %>
    <% end %>
    <% if cache_links[:warning].present? %>
      | <span><%= cache_links[:warning] %></span>
    <% end %>
    |
  <% end %>
  <%= link_to "Diagnose refresh", distillator_refresh_preview_url_for(@webpage.url) %>
</p>

<p>
  <strong>created:</strong>
  <%= @webpage.created_at %>
</p>

<p>
  <strong>updated:</strong>
  <%= @webpage.updated_at %>
</p>

<p>
  <strong>Language:</strong>
  <%= @webpage.language %>
</p>

<p>
  <strong>JSON-LD Output:</strong>
  <% if @webpage.jsonld_output  %>
    <%= @webpage.jsonld_output.name %>
  <% else %>
    System default
  <% end %>
</p>

<p>
  <strong>Rdf uri:</strong>
  <%= @webpage.rdf_uri %>
</p>

<p>
  <strong>Archive Date:</strong>
  <%= @webpage.archive_date %>
</p>

<p>
  <strong>Rdfs class:</strong>
  <%= @webpage.rdfs_class.name %>
</p>

<p>
  <strong>Website:</strong>
  <%= @webpage.website.seedurl %>
</p>

Live Google Rich Results SDTT:
<%= link_to "Call Condenser", "https://search.google.com/structured-data/testing-tool/u/0/#url=https://footlight-condenser.herokuapp.com/graphs/webpage/event.jsonld?url=#{CGI.escape(@webpage.url)}" %> |
<%= link_to "Code Snippet API", "https://search.google.com/structured-data/testing-tool/u/0/#url=https://graph.culturecreates.com/semantic/v2/webpage?url=#{CGI.escape(@webpage.url)}" %> 
<hr>


<%= link_to 'statements', statements_path(rdf_uri:@webpage.rdf_uri)  %> |
<%= link_to 'refresh', refresh_webpage_statements_path(url: @webpage.url), method: :patch  %> |


<%= link_to "Google JSON-LD", graphs_webpage_event_path(url: @webpage.url, format: :jsonld) %> |
<%= link_to "Artsdata JSON-LD", graphs_webpage_event_artsdasta_path(url: @webpage.url, format: :jsonld) %> |
<%= link_to 'Edit', edit_webpage_path(@webpage) %> |
<%= link_to 'Back', webpages_path %>

 


