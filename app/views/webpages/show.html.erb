<section class="webpage-show-section">
  <h1>
    <%= @webpage.url %>
    <span class="rollout-inline"><%= webpage_rollout_badge(@webpage) %></span>
  </h1>

  <dl class="webpage-identity-list">
    <% webpage_identity_rows(@webpage).each do |label, value| %>
      <dt><%= label %></dt>
      <dd><%= value %></dd>
    <% end %>
  </dl>

  <p class="webpage-debug-id"><%= webpage_debug_id_label(@webpage) %></p>
</section>

<% cache_links = webpage_cache_panel_links(@webpage) %>
<section class="webpage-rollout-panel webpage-show-section">
  <h2>Production transition</h2>
  <p><strong>Current public mode:</strong> <%= webpage_rollout_label_for(@webpage) %></p>
  <p><strong>Production backend:</strong> <%= webpage_rollout_backend_for(@webpage) %></p>
  <p><strong>Next recommended action:</strong> <%= webpage_rollout_next_step_for(@webpage, cache_links: cache_links) %></p>
  <% if cache_links[:active_cache_url].present? %>
    <p><strong>Primary cache link:</strong> <%= link_to cache_links[:label], cache_links[:active_cache_url] %></p>
  <% end %>

  <details class="webpage-rollout-panel">
    <summary>Diagnostics</summary>
    <%= render "shared/cache_link_panel", cache_links: cache_links, diagnose_url: distillator_refresh_preview_url_for(@webpage.url) %>
  </details>
</section>

<section class="webpage-show-section">
  <h2>Data actions</h2>
  <ul class="webpage-show-link-list">
    <li><%= link_to "Statements", statements_path(rdf_uri: @webpage.rdf_uri) %></li>
    <li><%= link_to "Refresh", refresh_webpage_statements_path(url: @webpage.url), method: :patch %></li>
  </ul>
</section>

<section class="webpage-show-section">
  <h2>JSON-LD</h2>
  <ul class="webpage-show-link-list">
    <li><%= link_to "Google JSON-LD", graphs_webpage_event_path(url: @webpage.url, format: :jsonld) %></li>
    <li><%= link_to "Artsdata JSON-LD", graphs_webpage_event_artsdasta_path(url: @webpage.url, format: :jsonld) %></li>
  </ul>
</section>

<section class="webpage-show-section">
  <h2>Validation</h2>
  <ul class="webpage-show-link-list">
    <li><%= link_to "Call Condenser", "https://search.google.com/structured-data/testing-tool/u/0/#url=https://footlight-condenser.herokuapp.com/graphs/webpage/event.jsonld?url=#{CGI.escape(@webpage.url)}" %></li>
    <li><%= link_to "Code Snippet API", "https://search.google.com/structured-data/testing-tool/u/0/#url=https://graph.culturecreates.com/semantic/v2/webpage?url=#{CGI.escape(@webpage.url)}" %></li>
  </ul>
</section>

<section class="webpage-show-section">
  <h2>Page actions</h2>
  <ul class="webpage-show-link-list">
    <li><%= link_to "Edit", edit_webpage_path(@webpage, return_to: @return_to) %></li>
    <li><%= link_to "Back", @return_to %></li>
  </ul>
</section>
