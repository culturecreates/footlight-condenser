<% webpage_cache_link_rows = @webpages.map { |webpage| [webpage, webpage_cache_links(webpage)] } %>
<% show_distillator_cache_column = webpage_cache_link_rows.any? do |_webpage, cache_links|
     cache_links[:secondary_links].any? { |link| link[:label] == Distillator::RolloutCopy.condenser_cache_label }
   end %>

<table>
  <thead>
    <tr>
      <th>Id</th>
      <th>Rdfs class</th>
      <th>Lang</th>
      <th>Url</th>
      <th>Publishable</th>

      <th>Rdf uri</th>
      <th>Archive Date</th>
      <th>JSON-LD Output</th>
      <th>Active Cache</th>
      <% if show_distillator_cache_column %>
        <th>Condenser Cache</th>
      <% end %>
      <th colspan="7"></th>
    </tr>
  </thead>

  <tbody>
    <% webpage_cache_link_rows.each do |webpage, cache_links| %>
      <tr>
        <td><%= webpage.id %></td>
        <td><%= webpage.rdfs_class.name %></td>
        <td><%= webpage.language %></td>
        <td><%= webpage.url %></td>
        <td><%= @publishable[webpage.id] %> </td>

        <td><%= webpage.rdf_uri %></td>


        <td><%= webpage.archive_date %></td>
        <td><%= webpage.jsonld_output&.name %></td>

        <td>
          <% if cache_links[:disabled] %>
            <span><%= cache_links[:warning] %></span>
          <% elsif cache_links[:active_cache_url].present? %>
            <%= link_to cache_links[:label], cache_links[:active_cache_url] %>
            <div class="rollout-note"><%= operator_active_backend_badge(cache_links) %></div>
            <div class="rollout-note"><%= webpage_rollout_badge(webpage) %></div>
          <% end %>
        </td>
        <% if show_distillator_cache_column %>
          <td>
            <% distillator_link = cache_links[:secondary_links].find { |link| link[:label] == Distillator::RolloutCopy.condenser_cache_label } %>
            <% if distillator_link.present? %>
              <%= link_to distillator_link[:label], distillator_link[:url] %>
            <% end %>
          </td>
        <% end %>
        <td><%= link_to 'statements', statements_path(rdf_uri:webpage.rdf_uri)  %></td>
      
       
        <td><%= link_to 'Show', webpage %></td>
        <td><%= link_to 'Edit', edit_webpage_path(webpage) %></td>
        <td>
          <%= button_to 'Destroy',
                webpage_path(webpage),
                method: :delete,
                form: { data: { confirm: 'Are you sure?', turbo: false } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
