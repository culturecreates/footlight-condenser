<% content_for :compact_operator_context, "true" %>
<main class="operator-workspace statement-workspace">
<header class="operator-editor__header">
  <div>
    <h1>Statements</h1>
    <p class="operator-editor__context"><%= number_with_delimiter(@statements.total_entries) %> matching
      <%= "statement".pluralize(@statements.total_entries) %></p>
  </div>
  <div class="operator-editor__actions">
    <% if @filters[:rdf_uri].present? %>
      <% uri = @filters[:rdf_uri] %>
      <%= link_to "Refresh URI", refresh_rdf_uri_statements_path(rdf_uri: uri), method: :patch, class: "operator-editor__button" %>
      <%= link_to "Crawl URI (1 hr cache)", refresh_rdf_uri_statements_path(rdf_uri: uri, force_scrape_every_hrs: 1), method: :patch, class: "operator-editor__button" %>
      <% console_url = uri.start_with?("adr:") ? "#{get_console_url_per_environment}/events/#{uri}" : "#{get_console_url_per_environment}/resource?uri=#{CGI.escape(uri)}" %>
      <%= link_to "Open in Console", console_url, class: "operator-editor__button" %>
    <% elsif @filters[:seedurl].present? && @filters[:seedurl] != "all" %>
      <%= link_to "Open in Console", contextual_console_url, class: "operator-editor__button" %>
    <% end %>
    <%= link_to "New statement", new_statement_path, class: "operator-editor__button operator-editor__button--primary" %>
  </div>
</header>

<%= render "shared/operator_active_filters", filters: @filters.except(:seedurl).merge(@filters.slice(:seedurl).reject { |_, value| value == "all" }),
      labels: { seedurl: "Website", rdf_uri: "Resource", prop: "Property ID", source: "Source ID", selected: "Selected source" } %>

<%= will_paginate @statements %>

<details class="statements-batch-actions harmonized-operator-section">
  <summary>Batch actions</summary>

  <p class="operator-note">
    These actions apply to the current listed statements after filters and pagination.
  </p>

  <%= form_tag(batch_update_statements_path, class: "statements-batch-form") do -%>
    <% @filters.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <%= hidden_field_tag :sort, @sort if @sort.present? %>
    <%= hidden_field_tag :direction, @direction if @direction.present? %>
    <%= hidden_field_tag :page, @pagination[:page] if @pagination[:page].present? %>
    <%= hidden_field_tag :per_page, @pagination[:per_page] if @pagination[:per_page].present? %>

    <div class="batch-action-row">
      <%= label_tag :update_data, "Update" %>
      <%= text_field_tag "update_data", "", size: 50, placeholder: 'selected: true, cache: ["one"]' %>
      <%= submit_tag "Update" %>
    </div>

    <div class="batch-action-row">
      <%= submit_tag "Review all listed" %>
      <%= submit_tag "Refresh all listed" %>
    </div>
  <% end -%>
</details>

<%= render "shared/tables/table_shell",
           table_key: :statements,
           records: @statements,
           row_partial: "statements/harmonized_row",
           row_name: :statement,
           headers: @statement_table_headers,
           filters: @filters,
           pagination: @pagination,
           sort: @sort,
           direction: @direction,
           sortable_filters: @sortable_filters,
           table_css_class: "cache-table statements-table",
           render_filters: true,
           empty_message: "No statements match the current filters." %>

<%= will_paginate @statements %>
<%= render "shared/source_page_preview" %>
</main>
