</style>

<p>
  <strong>Webpage:</strong>
  <%= @statement.webpage.url %>
  <a href="<%= get_wringer_url_per_environment %>/websites?term=<%= CGI.escape(CGI.escape(@statement.webpage.url)) %>"> View on Wringer</a> 
  <%= link_to "Show", webpage_path(@statement.webpage) %>
</p>

<p>
  <strong>updated:</strong>
  <%= @statement.updated_at %>
</p>

<% if @trace.present? && @show_trace && trace_mode %>
  <% steps = trace_steps_for_view(@trace) %>
  <% error_indices = steps.each_index.select { |i| steps[i][:error].present? } %>
  <% first_error_index = error_indices.first %>
  <% visible_indices =
      if error_indices.any?
        error_indices
          .flat_map { |i| (i - 2..i + 2).to_a }
          .select { |i| i >= 0 && i < steps.size }
          .uniq
      else
        start_index = [steps.size - 3, 0].max
        (start_index..[steps.size - 1, 0].max)
      end %>
  <% visible_indices = visible_indices.to_a %>
  <% hidden_count = [steps.size - visible_indices.size, 0].max %>
  <% first_error_step = first_error_index.nil? ? nil : steps[first_error_index]&.dig(:step) %>
  <hr>
  <h3>Algorithm Trace</h3>
  <style>
    /* Layout */
    .dsl-trace {
      font-family: monospace;
    }

    .trace-step {
      margin-bottom: 1em;
      padding: 0.5em;
      border-left: 3px solid #ccc;
    }

    .trace-step.collapsed {
      display: none;
    }

    /* Header */
    .trace-header {
      margin-bottom: 0.2em;
    }

    .trace-error {
      border-left: 3px solid #dc3545;
      background: #fff5f5;
    }

    .trace-first-error {
      border-left: 4px solid #ff0000;
      background: #fff0f0;
    }

    /* Title + status */
    .trace-step-title {
      font-weight: 600;
    }

    .trace-step-title.trace-ok {
      color: #28a745;
    }

    .trace-step-title.trace-warning {
      color: #ff8c00;
    }

    .trace-step-title.trace-error {
      color: #dc3545;
      font-weight: 700;
    }

    /* Step hints */
    .trace-hint {
      color: #ff8c00;
      font-size: 0.85em;
      margin-top: 0.2em;
      margin-bottom: 0.25em;
    }

    /* Expandables */
    .trace-code {
      color: #666;
      font-size: 0.9em;
      margin: 0.25em 0;
    }

    .trace-code-toggle,
    .trace-output-toggle {
      cursor: pointer;
      border-bottom: 1px dashed #ccc;
    }

    .trace-code-toggle:hover,
    .trace-output-toggle:hover {
      background: #f8f9fa;
    }

    .trace-code-toggle.expanded,
    .trace-output-toggle.expanded {
      white-space: normal;
    }

    .trace-output {
      padding: 6px 8px;
      margin-top: 4px;
      border-radius: 4px;
      font-weight: bold;
    }

    .trace-output.ok {
      background: #f6fff8;
      border-left: 3px solid #28a745;
    }

    .trace-output.warning {
      background: #fffbe6;
      border-left: 3px solid #ffc107;
    }

    .trace-output.error {
      background: #fff0f0;
      border-left: 3px solid #dc3545;
    }

    .trace-output span {
      display: inline-block;
      width: 100%;
      cursor: pointer;
    }

    .trace-output span.expanded {
      white-space: normal;
      font-family: monospace;
    }

    /* Meta blocks */
    .trace-meta,
    .trace-semantic,
    .trace-delta,
    .trace-probe,
    .trace-wringer {
      color: #555;
      font-size: 0.9em;
      margin-top: 2px;
    }

    .trace-meta {
      margin-top: 0.35em;
    }

    .trace-error-message {
      color: #dc3545;
      margin-top: 0.25em;
    }

    .trace-divider {
      border: 0;
      border-top: 1px solid #e6e6e6;
      margin: 0.45em 0;
    }

    /* Collapse controls */
    .trace-expand-block {
      cursor: pointer;
      color: #007bff;
      margin: 10px 0;
    }

    .trace-badge {
      margin-left: 8px;
      padding: 2px 6px;
      font-size: 11px;
      background: #dc3545;
      color: #fff;
      border-radius: 3px;
    }

    .trace-diagnosis {
      font-size: 12px;
      color: #666;
      margin-top: 4px;
      margin-bottom: 4px;
    }

    .trace-step.focused {
      border-left: 4px solid #007bff;
      background: #f4f9ff;
    }
  </style>

  <div class="dsl-trace">
    <% steps.each_with_index do |step, index| %>
      <%
        warning_type = compute_warning_type(step)
        status = compute_step_status(step)
        visible = visible_indices.include?(index)
        collapsed = !visible
        show_expand_block = collapsed && index == visible_indices.first.to_i - 1
        previous_step = index.positive? ? steps[index - 1] : nil
        explanation = explain_step(step, previous_step)
        suggestion = suggest_fix(step, previous_step)

        displayed_output =
          if step[:output].nil?
            step[:input]
          elsif step[:output] == []
            "[]"
          else
            step[:output]
          end

        full_output = step[:output_full] || step["output_full"] || displayed_output
        truncated_output = truncate(displayed_output.to_s, length: @trace_output_length)
        pretty_output =
          if full_output.is_a?(Array) && full_output.size <= 3
            "[" + full_output.map { |e| e.inspect }.join(", ") + "]"
          else
            truncated_output
          end
        full_output_text = "→ #{full_output}"
        truncated_output_text = "→ #{pretty_output}"
      %>
      <% if show_expand_block %>
        <div class="trace-expand-block" onclick="document.querySelectorAll('.trace-step.collapsed').forEach(function(e){ e.classList.remove('collapsed'); }); this.style.display='none';">
          Show all (<%= hidden_count %> hidden steps)
        </div>
      <% end %>

      <div class="trace-step <%= 'trace-error' if step[:error].present? %> <%= 'trace-first-error' if step[:step] == first_error_step %> <%= 'collapsed' if collapsed %>" data-warning-type="<%= warning_type %>" data-step="<%= step[:step] %>">
        <!-- HEADER -->
        <div class="trace-header">
          <span class="trace-step-title trace-<%= status %>">
            Step <%= step[:step] %> — <%= step[:type].presence || "unknown" %>
          </span>
          <% if index == first_error_index %>
            <span class="trace-badge">FIRST FAILURE</span>
          <% end %>
        </div>

        <!-- HINT -->
        <% if warning_type == :empty %>
          <div class="trace-hint">⚠ Empty result</div>
        <% elsif warning_type == :probe %>
          <div class="trace-hint">⚠ Probe used</div>
        <% end %>
        <% if explanation.present? %>
          <div class="trace-explanation"><%= explanation %></div>
        <% end %>
        <% if suggestion.present? %>
          <div class="dsl-suggestion">💡 <%= suggestion %></div>
        <% end %>

        <!-- CODE -->
        <% if step[:code].present? %>
          <% full_code = step[:code].to_s %>
          <% truncated_code = truncate(full_code, length: @trace_code_length) %>
          <div class="trace-code">
            <code>
              <span class="trace-code-toggle"
                    title="Click to expand"
                    onclick="event.stopPropagation(); toggleTraceExpandable(this)"
                    data-full="<%= h(full_code) %>"
                    data-truncated="<%= h(truncated_code) %>"><%= truncated_code %></span>
            </code>
          </div>
        <% end %>

        <!-- OUTPUT -->
        <div class="trace-output <%= status %>">
          <span class="trace-output-toggle"
                title="<%= h(full_output_text.to_s) %>"
                onclick="event.stopPropagation(); toggleTraceExpandable(this)"
                data-full="<%= h(full_output_text.to_s) %>"
                data-truncated="<%= h(truncated_output_text.to_s) %>"><%= truncated_output_text %></span>
        </div>

        <!-- META -->
        <div class="trace-semantic">
          <%= "#{step[:intent]} (#{step[:semantic]})" %>
        </div>

        <% if step[:semantic] == "Δ changed" && step[:delta].present? %>
          <div class="trace-delta">
            Δ <%= step[:delta] %>
          </div>
        <% end %>

        <% detail_semantic = semantic_label(step) %>
        <% redirect_url = interactive_redirect_info(step) %>
        <% links = wringer_links_for_step(step) %>

        <% if redirect_url.present? && detail_semantic == "Navigation" %>
        <div class="trace-subline trace-redirect">
          <span>⚠ redirected →</span>
          <span class="trace-redirect-url"><%= redirect_url %></span>
        </div>
        <% end %>

        <% if detail_semantic == "Navigation" && links.present? %>
          <div class="trace-navigation-links">
            <a href="<%= links[:wringer_search] %>" target="_blank" rel="noopener noreferrer">🔍 Open in Wringer</a>
            <a href="<%= links[:raw_url] %>" target="_blank" rel="noopener noreferrer">🌐 View page</a>
          </div>
        <% end %>

        <hr class="trace-divider">

        <div class="trace-meta">
        <% wringer = step[:wringer].is_a?(Hash) ? step[:wringer].with_indifferent_access : {} %>
        <div class="trace-wringer">
          <% if wringer.blank? %>
            ⚠ Missing wringer context
          <% elsif wringer[:inherited] %>
            ↪ Using previous page context
          <% else %>
            <% signals = wringer[:signals].is_a?(Hash) ? wringer[:signals].with_indifferent_access : {} %>
            <% network = signals[:network_status].presence || "unknown" %>
            <% content = signals[:content_type].presence || "unknown" %>
            <% icon = network == "ok" ? "✔" : (network == "failed" ? "❌" : "⚠") %>
            <%= "#{icon} Network: #{network.upcase} • Content: #{content.upcase}" %>
          <% end %>
        </div>

        <% probe =
             if step[:probe].nil?
               { missing: true }
             else
               step[:probe]
             end %>
        <% probe = probe.with_indifferent_access if probe.is_a?(Hash) %>
        <div class="trace-probe">
          <% if probe[:missing] %>
            ⚠ Missing probe data
          <% elsif probe[:skipped] %>
            ⏭ Probe skipped
          <% else %>
            <% probe_result = probe[:result].is_a?(Hash) ? probe[:result].with_indifferent_access : probe %>
            <% probe_ok = probe.key?(:ok) ? probe[:ok] : (probe_result[:status].to_s == "ok") %>
            <%= "#{probe_ok ? '✔' : '⚠'} Probe #{probe_result[:xpath]} → #{truncate(probe_result[:output].to_s, length: 100)}" %>
          <% end %>
        </div>
        </div>

        <% if step[:error].present? %>
          <div class="trace-error-message">
            ⚠ <%= truncate(step[:error].to_s, length: @trace_error_length) %>
          </div>
        <% end %>

        <% if step[:url_after].present? && step[:url_after] != step[:url_before] %>
          <div class="trace-url">
            URL → <%= step[:url_after] %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<script>
  const TRACE_VIEW_MODE = <%= @trace_view_mode.to_i %>;

  function toggleTraceExpandable(el) {
    if (!el || !el.dataset) return;
    const expanded = el.classList.toggle("expanded");
    const full = el.dataset.full;
    const truncated = el.dataset.truncated;
    el.textContent = expanded ? full : truncated;
  }

  function toggleDslStep(el) {
    if (TRACE_VIEW_MODE !== 4 || !el) return;

    const step = el.dataset.step;
    if (!step) return;

    el.classList.toggle("active");

    const details = document.querySelector('.dsl-step-details[data-step="' + step + '"]');
    if (!details) return;

    const isVisible = details.style.display === "block";
    details.style.display = isVisible ? "none" : "block";

    if (!isVisible) {
      const rect = details.getBoundingClientRect();
      const offset = window.innerHeight / 2 - rect.height / 2;

      window.scrollTo({
        top: window.scrollY + rect.top - offset,
        behavior: "smooth"
      });
    }
  }

  document.addEventListener("DOMContentLoaded", function() {
    if (TRACE_VIEW_MODE === 4) {
      const firstError = document.querySelector(".dsl-step.dsl-error");
      if (firstError) toggleDslStep(firstError);
      return;
    }

    const el = document.querySelector(".trace-first-error");
    if (!el) return;

    const rect = el.getBoundingClientRect();
    const offset = window.innerHeight / 2 - rect.height / 2;

    window.scrollTo({
      top: window.scrollY + rect.top - offset,
      behavior: "smooth"
    });
  });
</script>


