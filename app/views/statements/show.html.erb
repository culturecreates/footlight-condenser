

<p>
  <strong>Cache:</strong>
  <pre>
    <%= @statement.cache %>
  </pre>
</p>

<p>
  <strong>Status:</strong>
  <%= @statement.status %>
</p>


<p>
  <strong>manual:</strong>
  <%= @statement.manual %>
</p>

<p>
  <strong>selected_individual:</strong>
  <%= @statement.selected_individual %>
</p>

<p>
  <strong>Status origin:</strong>
  <%= @statement.status_origin %>
</p>

<p>
  <strong>Cache refreshed:</strong>
  <%= @statement.cache_refreshed %>
</p>

<p>
  <strong>Cache changed:</strong>
  <%= @statement.cache_changed %>
</p>

<%
  current_mode = @trace_view_mode.to_i
  trace_mode = current_mode == 3
  interactive_mode = current_mode == 4
  debug_mode = current_mode == 5
%>

<p>
  <strong>View:</strong>
  <%= case current_mode
      when 5 then "DEBUG 🟢 (Overview — all steps expanded)"
      when 4 then "INTERACTIVE 🔵 (Step-by-step)"
      when 3 then "TRACE 🟡"
      else "CLEAN ⚪"
      end %>
</p>
<p>
  <strong>Trace:</strong>
  <%= @show_trace ? "Enabled" : "Disabled" %>
</p>

<div class="dsl-source">
  <strong>Source:</strong>
  <%
    dsl_steps = split_algorithm_steps(@statement.source.algorithm_value)
    trace_steps = @trace.present? ? trace_steps_for_view(@trace) : []
    trace_by_step = {}
    trace_steps.each do |trace_step|
      trace_by_step[trace_step[:step].to_i] ||= []
      trace_by_step[trace_step[:step].to_i] << trace_step
    end
  %>

  <div class="dsl-steps">
    <% dsl_steps.each_with_index do |code, i| %>
      <% step_number = i + 1 %>
      <% type = code.split("=").first.to_s.strip %>
      <% trace_entries = trace_by_step[step_number] || [] %>
      <% primary_step = trace_entries.last || { step: step_number, type: type } %>
      <% previous_primary_step = (trace_by_step[step_number - 1] || []).last %>
      <% dsl_status = trace_entries.any? ? compute_step_status(primary_step) : :neutral %>
      <% semantic = semantic_label(primary_step.merge(type: primary_step[:type].presence || type)) %>
      <% explanation = explain_step(primary_step, previous_primary_step) %>
      <% suggestion = suggest_fix(primary_step, previous_primary_step) %>
      <div class="dsl-step <%= 'clickable' if interactive_mode %> <%= "dsl-#{dsl_status}" if (trace_mode || interactive_mode || debug_mode) %>"
           data-step="<%= step_number %>"
           <% if interactive_mode %>onclick="toggleDslStep(this)"<% end %>>
        <span class="dsl-step-index"><%= i + 1 %></span>
        <% if interactive_mode %>
          <div class="dsl-step-main">
            <% if semantic == "Condition" %>
              <span class="dsl-step-type dsl-step-label">Condition</span><span class="dsl-step-subtle">[If found]</span>
            <% else %>
              <span class="dsl-step-type dsl-step-label"><%= semantic %></span>
            <% end %>
            <% if explanation.present? %>
              <span class="dsl-step-explanation"><%= explanation %></span>
            <% end %>
            <% if suggestion.present? %>
              <div class="dsl-suggestion">💡 <%= suggestion %></div>
            <% end %>
          </div>
        <% else %>
          <% if semantic == "Condition" %>
            <span class="dsl-step-type dsl-step-label">Condition</span><span class="dsl-step-subtle">[If found]</span>
          <% else %>
            <span class="dsl-step-type"><%= semantic %></span>
          <% end %>
          <code class="dsl-step-code"><%= code %></code>
        <% end %>
      </div>
      <% if debug_mode || interactive_mode %>
        <div class="dsl-step-details" data-step="<%= step_number %>" style="display:<%= interactive_mode ? 'none' : 'block' %>;">
          <% step = trace_entries.last %>
          <% if step.present? %>
              <% full_code = step[:code].to_s %>
              <% truncated_code = truncate(full_code, length: @trace_code_length) %>
              <% output_preview = trace_display_output(step) %>
              <% full_output_text = output_preview.to_s %>
              <% truncated_output_text = truncate(output_preview.to_s, length: @trace_output_length) %>
              <% previous_step = trace_by_step[step[:step].to_i - 1]&.last %>
              <% detail_suggestion = suggest_fix(step, previous_step) %>
              <% wringer_meta = interactive_wringer_meta(step) %>
              <% probe_text = interactive_probe_text(step) %>
              <% links = wringer_links_for_step(step) %>
              <% detail_semantic = semantic_label(step) %>
              <% redirect_url = interactive_redirect_info(step) %>
              <div class="trace-mini">
                <% if step[:error].present? %>
                  <div class="trace-error-message">⚠ <%= truncate(step[:error].to_s, length: @trace_error_length) %></div>
                <% end %>

                <% if step[:code].present? %>
                  <div class="trace-code">
                    <span class="trace-code-toggle"
                          onclick="event.stopPropagation(); toggleTraceExpandable(this)"
                          data-full="<%= h(full_code) %>"
                          data-truncated="<%= h(truncated_code) %>"><%= truncated_code %></span>
                  </div>
                <% end %>

                <div class="trace-output-line">
                  <span class="trace-arrow">→</span>
                  <span class="trace-output-toggle"
                          onclick="event.stopPropagation(); toggleTraceExpandable(this)"
                          data-full="<%= h(full_output_text) %>"
                          data-truncated="<%= h(truncated_output_text) %>"><%= truncated_output_text %></span>
                </div>

                <% if redirect_url.present? && detail_semantic == "Navigation" %>
                  <div class="trace-subline trace-redirect">
                    <span>⚠ redirected →</span>
                    <span class="trace-redirect-url"><%= redirect_url %></span>
                  </div>
                <% end %>

                <% if links.present? && detail_semantic == "Navigation" %>
                  <div class="trace-navigation-links">
                    <a href="<%= links[:wringer_search] %>" target="_blank" rel="noopener noreferrer">🔍 Open in Wringer</a>
                    <a href="<%= links[:raw_url] %>" target="_blank" rel="noopener noreferrer">🌐 View page</a>
                  </div>
                <% end %>

                <% if wringer_meta.present? || probe_text.present? %>
                  <div class="trace-output-meta">
                    <% if wringer_meta.present? %>
                      <div><%= wringer_meta %></div>
                    <% end %>
                    <% if probe_text.present? %>
                      <div class="trace-probe-insight"><%= probe_text %></div>
                    <% end %>
                  </div>
                <% end %>

                <% if interactive_mode && detail_suggestion.present? %>
                  <div class="dsl-suggestion">💡 <%= detail_suggestion %></div>
                <% end %>

                <% if interactive_mode && step[:delta].present? %>
                  <div class="trace-delta">Δ <%= step[:delta] %></div>
                <% end %>
              </div>
          <% else %>
            <div class="trace-mini">
              <div>→ (no preview available)</div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= link_to "Show", source_path(@statement.source.id) %>
</div>

<style>
  .dsl-steps {
    margin-top: 6px;
  }

  .dsl-step {
    display: flex;
    gap: 8px;
    padding: 2px 0;
  }

  .dsl-step.clickable {
    cursor: pointer;
  }

  .dsl-step.active {
    background: #eef6ff;
    border-left: 3px solid #007bff;
  }

  .dsl-step.dsl-ok {
    color: #1e7e34;
    border-left: 3px solid #28a745;
    background: #f6fff8;
    opacity: 0.75;
  }

  .dsl-step.dsl-warning {
    color: #b26a00;
    border-left: 3px solid #ff8c00;
    background: #fffbe6;
  }

  .dsl-step.dsl-error {
    color: #a71d2a;
    border-left: 3px solid #dc3545;
    background: #fff0f0;
    opacity: 1;
  }

  .dsl-step.dsl-neutral {
    color: #555;
    border-left: 3px solid #bdbdbd;
    background: #fafafa;
  }

  .dsl-step-index {
    width: 24px;
    color: #888;
  }

  .dsl-step-type {
