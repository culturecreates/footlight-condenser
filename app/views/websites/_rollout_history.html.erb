<% if events.any? %>
  <ul>
    <% events.each do |event| %>
      <li>
        <strong><%= Distillator::WebsiteOperationStatus.event_label(event) %></strong> · <%= event.created_at.strftime("%Y-%m-%d %H:%M %Z") %>
        <% if event.reason.present? || event.readiness_snapshot["blockers"].present? || event.readiness_snapshot["warnings"].present? %>
          <details class="rollout-audit-details">
            <summary><%= Distillator::WebsiteOperationStatus.reviewed?(event) ? "Warnings accepted at activation" : "Readiness snapshot at decision time" %></summary>
            <% if event.reason.present? %><p>Reason: <%= event.reason %></p><% end %>
            <% if event.readiness_snapshot["blockers"].present? %><p>Blockers at that time: <%= Array(event.readiness_snapshot["blockers"]).join(", ") %></p><% end %>
            <% if event.readiness_snapshot["warnings"].present? %><p>Warnings at that time: <%= Array(event.readiness_snapshot["warnings"]).join(", ") %></p><% end %>
          </details>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No rollout events recorded yet.</p>
<% end %>
