
<h1>Websites</h1>
Total Statements: <%= number_to_human(@total_statements) %>
<br>
Last 24 hrs:  <%= @statements_errors %> errors
<br>

<div class="website-rollout-summary">
  <span class="website-rollout-summary-item">
    <strong>Legacy Wringer active:</strong>
    <%= website_rollout_count(:legacy, @rollout_counts) %>
  </span>
  <span class="website-rollout-summary-item">
    <strong>Shadow comparison:</strong>
    <%= website_rollout_count(:shadow, @rollout_counts) %>
  </span>
  <span class="website-rollout-summary-item">
    <strong>Condenser active:</strong>
    <%= website_rollout_count(:active, @rollout_counts) %>
  </span>
</div>

<nav class="website-rollout-filters" aria-label="Website rollout filters">
  <% website_rollout_filter_options.each do |label, mode| %>
    <span class="website-rollout-filter-link">
      <%= website_rollout_filter_link(
        label: label,
        mode: mode,
        current_filters: @filters,
        current_sort: @current_sort,
        current_direction: @current_direction
      ) %>
    </span>
  <% end %>
</nav>

<%= form_with url: websites_path, method: :get, local: true, html: { autocomplete: "off" } do %>
  <%= hidden_field_tag :sort, @current_sort if @current_sort.present? %>
  <%= hidden_field_tag :direction, @current_direction if @current_direction.present? %>

  <table>
    <thead>
      <tr>
        <th><%= sortable("name", "Name") %></th>
        <th><%= sortable("seedurl", "Seedurl") %></th>
        <th><%= sortable("default_language", "Default Language") %></th>
        <th><%= sortable("schedule_every_days", "Schedule Every") %> <br>(days)</th>
        <th><%= sortable("schedule_time", "Schedule Time") %></th>
        <th><%= sortable("last_refresh", "Last Refresh") %></th>
        <th><%= sortable("graph_name", "Graph Name") %></th>
        <th><%= sortable("webpages_count", "Webpages") %></th>
        <th><%= sortable("statements_count", "Statements") %></th>
        <th><%= sortable("refreshed_24h", "24 hr refreshed") %></th>
        <th><%= sortable("updated_24h", "24 hr updated") %></th>
        <th colspan="5"></th>
      </tr>
      <tr>
        <td><%= text_field_tag :q, @filters[:q], autocomplete: "off" %></td>
        <td><%= text_field_tag :seed_filter, @filters[:seed_filter], autocomplete: "off" %></td>
        <td>
          <%= select_tag :default_language,
                         options_for_select([["", ""], ["en", "en"], ["fr", "fr"]], @filters[:default_language]) %>
        </td>
        <td></td>
        <td></td>
        <td></td>
        <td>
          <%= text_field_tag :graph_name, @filters[:graph_name], autocomplete: "off" %>
          <div class="website-rollout-inline-filter">
            <%= select_tag :distillator_mode,
                           options_for_select(
                             [["All rollout states", ""]] + website_rollout_filter_options.reject { |_label, mode| mode.nil? },
                             @filters[:distillator_mode]
                           ) %>
          </div>
        </td>
        <td colspan="8">
          <%= submit_tag "Apply filters" %>
          <%= link_to "Reset filters", websites_path %>
        </td>
      </tr>
    </thead>

    <tbody>
      <% @websites.each do |website| %>
        <tr>
          <td>
            <%= link_to website.name, website %>
            <div class="rollout-note">
              <%= website_rollout_badge(website) %>
            </div>
          </td>
          <td><%= website.seedurl %></td>
          <td><%= website.default_language %></td>
          <td><%= website.schedule_every_days %></td>
          <td><%= display_time(website.schedule_time) %></td>
          <td><%= website.last_refresh %></td>
          <td><%= website.graph_name %></td>
          <td><%= @webpages[website.id] || 0 %></td>
          <td><%= @statements_grouped[website.seedurl] || 0 %></td>
          <td><%= @statements_refreshed_24hr[website.seedurl] || 0 %></td>
          <td><%= @statements_updated_24hr[website.seedurl] || 0 %></td>

          <% cache_links = website_cache_links(website) %>
          <td>
            <% if cache_links[:disabled] %>
              <span><%= cache_links[:warning] %></span>
            <% elsif cache_links[:active_cache_url].present? %>
              <%= link_to cache_links[:label], cache_links[:active_cache_url] %>
            <% end %>
          </td>
          <td><%= link_to 'Show', website %></td>
          <td><%= link_to 'Export', graphs_website_queue_path(seedurl: website.seedurl) %></td>
          <td><%= link_to 'Edit', edit_website_path(website) %></td>
          <td><%= link_to 'Destroy', website, method: :delete, data: { confirm: 'Are you sure?', turbo: false } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<br>

<%= link_to 'New Website', new_website_path %>
