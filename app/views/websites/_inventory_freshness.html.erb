<% tone = if inventory[:status] == "confirmed_discovery"
  "passed"
elsif %w[stale discovery_unverified discovery_pending_import].include?(inventory[:status])
  "review"
else
  "neutral"
end %>
<span class="operator-status operator-status--<%= tone %>" data-inventory-status="<%= inventory[:status] %>"><%= inventory[:label] %></span>
<% if inventory[:latest_list_refresh_at] %>
  <% refreshed_at = Time.iso8601(inventory[:latest_list_refresh_at]).in_time_zone %>
  <%= time_tag refreshed_at, refreshed_at.strftime("%b %-d %H:%M"), title: "Latest paired ResourceList statement extraction · #{refreshed_at}" %>
<% end %>
<br>
<small title="Age of the last event webpage added, including imported or manually added events">
  New event <%= inventory[:new_event_age_days].nil? ? "—" : "#{inventory[:new_event_age_days]}d" %>
</small>
· <small title="Active publishable event URLs selected for a Thorough transition that match neither URL nor RDF URI in verified ResourceLists">
  <%= inventory[:selected_event_urls_missing].nil? ? "Outside lists unknown" : "#{inventory[:selected_event_urls_missing]} outside lists" %>
</small>

<% if inventory[:unpublishable_urls_count].to_i.positive? %>
  <br><small><%= pluralize(inventory[:unpublishable_urls_count], "listed event") %> missing required statements</small>
<% end %>
