
<h1>
  <%= @website.name %>
  <% if website_cohort_badge(@website).present? %>
    <span class="rollout-inline"><%= website_cohort_badge(@website) %></span>
  <% end %>
  <span class="rollout-inline"><%= website_rollout_badge(@website) %></span>
</h1>

<p class="rollout-note"><%= website_rollout_explanation(@website) %></p>

<p>
  <strong>Seedurl:</strong>
  <%= @website.seedurl %>
</p>

<% cache_links = website_cache_panel_links(@website) %>
<section class="website-rollout-panel">
  <h2><%= Distillator::RolloutCopy.rollout_panel_title %></h2>
  <p><strong>Current mode:</strong> <%= website_rollout_label_for(@website) %></p>
  <p><strong>Production backend:</strong> <%= website_rollout_backend_for(@website) %></p>
  <p><strong>Next step:</strong> <%= website_rollout_next_step_for(@website) %></p>

  <h3>Links</h3>
  <%= render "shared/cache_link_panel", cache_links: cache_links, diagnose_url: nil %>
</section>

<p>
  <strong>Default Language:</strong>
  <%= @website.default_language %>
</p>

<p>
  <strong>graph_name:</strong>
  <%= @website.graph_name %>
</p>

<section class="website-rollout-panel">
  <h2>Recent rollout events</h2>
  <% if @website.rollout_events.order(created_at: :desc).limit(5).any? %>
    <ul>
      <% @website.rollout_events.order(created_at: :desc).limit(5).each do |event| %>
        <li>
          <%= [event.from_mode.presence || "unknown", "to", event.to_mode, event.created_at].join(" ") %>
          <% if event.readiness_snapshot["blockers"].present? %>
            | blockers: <%= Array(event.readiness_snapshot["blockers"]).join(", ") %>
          <% end %>
          <% if event.readiness_snapshot["warnings"].present? %>
            | warnings: <%= Array(event.readiness_snapshot["warnings"]).join(", ") %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No rollout events recorded yet.</p>
  <% end %>
</section>

<%= link_to 'Edit', edit_website_path(@website) %> |
<%= link_to 'Back', websites_path %>
<hr>
<h1> Jobs</h1>
<%= link_to 'View resources with lists', lists_path(seedurl: @website.seedurl) %> 
<br>
<%= link_to 'Export step-by-step', graphs_website_path(seedurl: @website.seedurl) %>


<h1>Batch Jobs</h1>
<%= link_to 'Refresh upcoming events', refresh_upcoming_events_batch_jobs_path(seedurl: @website.seedurl) %> 
<br>
<%= link_to 'Refresh lists and add webpages', check_for_new_webpages_batch_jobs_path(seedurl: params[:seedurl]) %>
<br>
<%= link_to 'Refresh all Webpages (all classes, all dates)', refresh_webpages_batch_jobs_path(seedurl: @website.seedurl) %> 
<br>
<%= link_to 'Export Events to Artsdata', graphs_website_queue_path(seedurl: @website.seedurl) %>


<h3 style="color:red">  DESTROY </h3>
<div style="display:block;float: left">
 <%= button_to 'Destroy all statements', delete_all_statements_websites_path(id: @website.id), method: :delete, data: { confirm: 'Are you sure to delete all #{@website.seedurl} statements ?' } %>
 <%= button_to 'Destroy all webpages', delete_all_webpages_websites_path(id: @website.id), method: :delete, data: { confirm: 'Are you sure to delete all #{@website.seedurl} statements ?' } %>
 <%= button_to 'Destroy all EVENT webpages', delete_all_event_webpages_websites_path(id: @website.id), method: :delete, data: { confirm: 'Are you sure to delete all #{@website.seedurl} statements ?' } %>
