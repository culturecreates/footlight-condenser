<% milestone = @validation_summary&.milestone %>
<% compact_transition = milestone.in?(%w[ready migrated]) %>

<section class="website-show-section">
  <h1>
    <%= @website.name %>
    <% if website_cohort_badge(@website).present? %>
      <span class="rollout-inline"><%= website_cohort_badge(@website) %></span>
    <% end %>
    <% if milestone %>
      <span class="rollout-inline website-state-badge" data-migration-state="<%= milestone %>"><%= milestone.humanize %></span>
    <% else %>
      <span class="rollout-inline"><%= website_rollout_badge(@website) %></span>
    <% end %>
  </h1>

  <dl class="website-identity-list">
    <% website_identity_rows(@website).each do |label, value| %>
      <dt><%= label %></dt>
      <dd><%= value %></dd>
    <% end %>
  </dl>

  <p class="website-debug-id"><%= website_debug_id_label(@website) %></p>
  <% if (Rails.env.development? || Rails.env.test? || Distillator::TransitionRuntime.staging?) && !@website.test_copy_of_website_id %>
    <section class="website-show-section" id="website-qa-copy">
      <h2>Copy website for QA</h2>
      <p>Clone this site's Sources, Webpages and Statements into an unscheduled QA website with separate RDF identities.
        The original is unchanged; the copy retains source URLs but does not automatically refresh, import or publish.</p>
      <%= form_with url: copy_for_qa_website_path(@website), method: :post, local: true do |form| %>
        <%= label_tag :test_copy_seedurl, "Test seedurl" %>
        <%= text_field_tag :test_copy_seedurl, Websites::CreateTestCopy.suggest_seedurl(@website.seedurl), required: true %>
        <%= form.submit "Create QA copy" %>
      <% end %>
    </section>
  <% end %>
  <% if (Rails.env.development? || Rails.env.test? || Distillator::TransitionRuntime.staging?) &&
        ResourceLists::DanseDanseKeyedPreview.eligible?(@website) %>
    <section class="website-show-section" id="qa-multilingual-pairing">
      <h2>Multilingual ResourceList pairing (QA)</h2>
      <p>Compare all explicitly configured English and French ResourceList pages. Read-only; live-site pagination completeness remains unverified.</p>
      <%= button_to "Preview multilingual pairing", preview_multilingual_pairing_website_path(@website), method: :post %>
    </section>
  <% end %>
</section>

<% transition_contract = website_transition_contract(@website) %>
<% active = @website.distillator_mode == "active" %>
<% operation = website_operation_status(@website) if active %>

<% if active %>
  <section class="website-rollout-panel website-show-section" id="active-operation">
    <h2>Active on Condenser</h2>
    <% if (cutover = @validation_summary.cutover) %>
      <p><strong>Migration confirmed</strong>
        <% if cutover.event %> · <%= l(cutover.completed_at.in_time_zone, format: :short) %><% end %>
        · <%= link_to "Rollout history", "#website-rollout-history" %>
      </p>
    <% elsif @validation_summary.confirmable_cutover? %>
      <%= render "confirm_cutover", website: @website %>
    <% end %>
    <% if operation.activation %>
      <p><strong><%= Distillator::WebsiteOperationStatus.event_label(operation.activation) %></strong>
        · <%= operation.activation.created_at.strftime("%Y-%m-%d %H:%M %Z") %></p>
      <% if operation.activation.reason.present? %>
        <p><%= Distillator::WebsiteOperationStatus.reviewed?(operation.activation) ? "Review reason" : "Activation reason" %>: <%= operation.activation.reason %></p>
      <% end %>
    <% end %>
    <% observed = operation.observed_fetch %>
    <p class="<%= observed[:failed] ? 'cache-page-notice' : 'cache-page-note' %>"><strong><%= observed[:label] %></strong></p>
    <% if observed[:attempted_at] %>
      <p><%= observed[:attempted_at].strftime("%Y-%m-%d %H:%M %Z") %>
        <% if observed[:backend] %> · Backend: <%= observed[:backend] %><% end %>
        · <%= webpage_url_link(observed[:url]) %></p>
      <% if observed[:redirected] %><p>Observed redirect: <%= webpage_url_link(observed[:url]) %> → <%= webpage_url_link(observed[:final_url]) %></p><% end %>
      <p class="cache-page-note">This observation covers the latest cached page.</p>
    <% else %>
      <p>Refresh upcoming events to validate fetching and extraction after activation.</p>
    <% end %>
    <% counts = operation.statement_counts %>
    <% if counts.any? %>
      <p>Selected statements on upcoming event pages:
        <%= counts.fetch("problem", 0) %> problems,
        <%= counts.fetch("missing", 0) %> missing,
        <%= counts.fetch("initial", 0) %> awaiting review.</p>
    <% end %>
    <%= link_to "Refresh upcoming events", refresh_upcoming_events_batch_jobs_path(seedurl: @website.seedurl) %>
  </section>
<% end %>

<%= content_tag(compact_transition ? :details : :section, id: "website-transition", class: "website-rollout-panel website-show-section") do %>
  <% if compact_transition %>
    <summary>Latest comparison</summary>
  <% else %>
    <h2><%= active ? "Latest comparison" : "Transition verdict" %></h2>
  <% end %>
  <p><strong><%= website_transition_verdict_line(@website) %></strong></p>
  <p><%= website_transition_secondary_status_line(@website) %></p>
<% end %>

<%= render "validation_history" %>

<%= content_tag(compact_transition ? :details : :section, id: "website-transition-controls", class: "website-rollout-panel website-show-section",
    open: (true if compact_transition && params[:comparison] == "thorough")) do %>
  <% if compact_transition %>
    <summary>Active operation and rollback</summary>
  <% else %>
    <h2><%= active ? "Active operation and rollback" : "Blocking reason / promote control" %></h2>
  <% end %>
  <% primary_action = transition_contract[:primary_action] %>
  <% if active %>
    <details>
      <summary>Rollback to Legacy Wringer</summary>
      <p>Return this website's fetching to Legacy Wringer. The decision is recorded in rollout history.</p>
      <%= button_to primary_action[:label], primary_action[:path], method: primary_action[:method], params: primary_action[:params], class: "website-transition-button" %>
    </details>
  <% elsif primary_action[:enabled] %>
    <%= button_to primary_action[:label], primary_action[:path], method: primary_action[:method], params: primary_action[:params], class: "website-transition-button" %>
  <% else %>
    <p class="transition-context-disabled-action">
      <strong><%= primary_action[:label] %>:</strong>
      <%= primary_action[:message] %>
      <%= link_to "See latest transition report", distillator_shadow_report_site_path(@website) %>
    </p>
  <% end %>

  <% transition_contract[:secondary_actions].reject { |action| action[:emergency] }.each do |action| %>
    <% if action[:kind] == :override %>
      <details class="website-transition-override">
        <summary><%= action[:label] %></summary>
        <p><%= action[:copy] %></p>
        <%= form_with url: action[:path], method: action[:method], local: true, class: "website-transition-override-form" do |form| %>
          <%= form.label :reason, "Reason" %>
          <%= form.text_field :reason, required: true %>
          <%= form.submit action[:label] %>
        <% end %>
      </details>
    <% end %>
  <% end %>

  <section id="website-batch-jobs-transition" class="website-rollout-panel">
    <h3>Transition batch check</h3>
    <p><%= website_transition_batch_check_copy %></p>
    <% latest_run = website_operation_status(@website).latest_run %>
    <% check_options = if params[:comparison] == "thorough"
      Distillator::TransitionCheckOptions.new(sample_mode: "all", strictness: "strict")
    else
      latest_run ? latest_run.options : Distillator::TransitionCheckOptions.new
    end %>
    <%= form_with url: website_transition_batch_check_path, method: :post, local: true, class: "website-transition-check-form" do %>
      <% website_transition_batch_check_params(@website, return_to: website_transition_batch_status_path(@website)).each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <fieldset <%= "disabled" if latest_run&.status.in?(%w[queued running]) %>>
        <p>
          <%= label_tag "check_options_sample_mode", "Event sample" %>
          <%= select_tag "check_options[sample_mode]", options_for_select([
            ["Default sample (20%, minimum 5, maximum 25)", "default"],
            ["Fixed number of pages", "count"], ["All active public webpages of publishable events", "all"]
          ], check_options.sample_mode) %>
          <%= label_tag "check_options_sample_size", "Page count (Fixed number of pages only)" %>
          <%= number_field_tag "check_options[sample_size]", check_options.sample_size || 25,
            min: 1, max: Distillator::TransitionCheckOptions::MAX_SAMPLE_SIZE, step: 1 %>
        </p>
        <p>
          <%= label_tag "check_options_strictness", "Field comparison" %>
          <%= select_tag "check_options[strictness]", options_for_select([
            ["Standard: core differences block; other differences warn", "standard"],
            ["Strict: differences in any selected field block", "strict"]
          ], check_options.strictness) %>
        </p>
        <p class="cache-page-note">Full checks include each active public webpage for events that are publishable across their pages.
          Sites without Event pages or selected Event sources can check other website pages.</p>
        <p class="cache-page-note">Full-scope Strict checks refetch ResourceList sources, refresh their statements and reconcile discovered URLs before choosing event pages.</p>
        <%= submit_tag(params[:comparison] == "thorough" ? "Run Thorough validation" : "Run transition batch check", class: "website-transition-button") %>
      </fieldset>
    <% end %>
    <% if @website.webpages.event_pages.archived.exists? %>
      <%= button_to "Audit archived events", website_transition_batch_check_path, method: :post,
        params: { website_id: @website.id, check_options: { sample_mode: "all", strictness: "strict", include_retired: true } } %>
      <% if (historical_run = @website.transition_runs.historical_audits.order(id: :desc).first) %>
        <p><%= link_to "View latest historical audit", distillator_transition_check_path(historical_run) %></p>
      <% end %>
    <% end %>
    <p><%= website_transition_evidence_freshness_text(@website) %></p>
    <% if latest_run %>
      <p><%= link_to "View run ##{latest_run.id} status", distillator_transition_check_path(latest_run) %></p>
    <% end %>
  </section>
<% end %>

<% transition_contract[:secondary_actions].select { |action| action[:emergency] }.each do |action| %>
  <details class="website-transition-override website-show-section" id="website-emergency-override">
    <summary>Emergency activation override</summary>
    <p>Bypasses transition gates, including a queued or running check. Use only for an intentional emergency activation.</p>
    <p><%= action[:copy] %></p>
    <%= form_with url: action[:path], method: action[:method], local: true, class: "website-transition-override-form" do |form| %>
      <%= form.label :reason, "Emergency activation reason" %>
      <%= form.text_field :reason, required: true %>
      <%= form.submit action[:label] %>
    <% end %>
  </details>
<% end %>

<section class="website-rollout-panel website-show-section">
  <h2>Drill-down links</h2>
  <ul class="website-show-link-list">
    <li><%= link_to "Selected XPath sources", website_sources_index_path(@website) %></li>
    <% website_transition_drill_down_links(@website).each do |link| %>
      <li><%= link %></li>
    <% end %>
  </ul>
</section>

<section class="website-show-section">
  <h2>Operations</h2>
  <ul class="website-show-link-list">
    <li><%= link_to "Edit", edit_website_path(@website) %></li>
    <% if (Rails.env.development? || Rails.env.test? || Distillator::TransitionRuntime.staging?) && !@website.test_copy_of_website_id %>
      <li><%= link_to "Create QA copy", "#website-qa-copy" %></li>
    <% end %>
    <li><%= link_to "View resources with lists", lists_path(seedurl: @website.seedurl) %></li>
    <li><%= link_to "Export step-by-step", graphs_website_path(seedurl: @website.seedurl) %></li>
    <% unless active %><li><%= link_to "Refresh upcoming events", refresh_upcoming_events_batch_jobs_path(seedurl: @website.seedurl) %></li><% end %>
    <li><%= link_to "Refresh list statements and reconcile discovered URLs", check_for_new_webpages_batch_jobs_path(seedurl: @website.seedurl) %></li>
    <li><%= link_to "Refresh all Webpages (all classes, all dates)", refresh_webpages_batch_jobs_path(seedurl: @website.seedurl) %></li>
    <li><%= link_to "Export Events to Artsdata", graphs_website_queue_path(seedurl: @website.seedurl) %></li>
  </ul>
</section>

<section id="website-rollout-history" class="website-rollout-panel website-show-section">
  <h2>Recent rollout events</h2>
  <%= render "websites/rollout_history", events: @website.rollout_events.order(created_at: :desc, id: :desc).limit(5) %>

</section>

<details class="website-danger-zone website-show-section">
  <summary>Danger zone</summary>

  <div class="website-danger-zone-body">
    <%= button_to "Destroy website", website_path(@website), method: :delete, data: { confirm: "Are you sure you want to destroy #{@website.seedurl}?", turbo: false } %>
    <%= button_to "Destroy all statements", delete_all_statements_websites_path(id: @website.id), method: :delete, data: { confirm: "Are you sure to delete all #{@website.seedurl} statements ?" } %>
    <%= button_to "Destroy all webpages", delete_all_webpages_websites_path(id: @website.id), method: :delete, data: { confirm: "Are you sure to delete all #{@website.seedurl} statements ?" } %>
    <%= button_to "Destroy all EVENT webpages", delete_all_event_webpages_websites_path(id: @website.id), method: :delete, data: { confirm: "Are you sure to delete all #{@website.seedurl} statements ?" } %>
  </div>
</details>
