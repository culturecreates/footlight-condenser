<p id="notice"><%= notice %></p>

<h1>Messages</h1>

<%= form_with url: messages_path, method: :get, local: true, class: "harmonized-table-filters" do %>
  <%= label_tag :seedurl, "Site" %>
  <%= select_tag :seedurl, options_for_select([["All sites", ""]] + @site_options, @seedurl) %>
  <%= submit_tag "Filter messages" %>
  <%= link_to "Clear filter", messages_path %>
<% end %>

<p><%= page_entries_info @messages %></p>
<%= will_paginate @messages, params: @pagination_params %>

<table class="cache-table messages-table">
  <thead>
    <tr>
    <th>Date</th>
      <th>Message</th>
      <th>Artifact</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @messages.each do |message| %>
      <tr>
      <td><%= message.created_at %></td>
        <td><%= message.message %></td>
        <td><%= message.artifact %></td>
        <td><%= link_to 'Show', message %></td>
        <td><%= link_to 'Edit', edit_message_path(message) %></td>
        <td><%= link_to 'Destroy', message, method: :delete, data: { confirm: 'Are you sure?', turbo: false } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= will_paginate @messages, params: @pagination_params %>
<br>

<%= link_to 'New Message', new_message_path %>
