<h1>Monitoring</h1>
<p>Only errors explicitly flagged by DSL appear here. A successful statement refresh resolves its issue.</p>
<%= form_with url: monitoring_path, method: :get, local: true do %>
  <%= label_tag :seedurl, "Site" %>
  <%= select_tag :seedurl, options_for_select([["All sites", "all"]] + @sites.map { |site| [site, site] }, @seedurl || "all") %>
  <%= label_tag :status, "Status" %>
  <%= select_tag :status, options_for_select([["Open", "open"], ["Resolved", "resolved"], ["All", "all"]], @status) %>
  <%= submit_tag "Filter" %>
<% end %>
<p><%= @issues.total_entries %> issues</p>
<%= will_paginate @issues, params: { seedurl: @seedurl || "all", status: @status } %>
<table>
  <thead><tr><th>Site / property</th><th>Error</th><th>Last seen</th><th>Occurrences</th><th>Status</th><th>Inspect</th></tr></thead>
  <tbody>
    <% @issues.each do |issue| %>
      <tr>
        <td><strong><%= issue.website_name.presence || issue.seedurl %></strong><br><%= issue.property_name %></td>
        <td><%= issue.message %></td><td><span title="First seen: <%= issue.first_seen_at %>"><%= issue.last_seen_at %></span></td><td><%= issue.occurrences %></td>
        <td><%= issue.resolved_at? ? "Resolved" : "Open" %></td>
        <td><%= link_to "Source ##{issue.source_id}", source_path(issue.source_id) %>
          <% if issue.statement_id %> · <%= link_to "Statement ##{issue.statement_id}", statement_path(issue.statement_id) %><% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @issues.empty? %><p>No monitored issues match these filters.</p><% end %>
