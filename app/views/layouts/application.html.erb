<!DOCTYPE html>
<html>
  <head>
    <title>Condenser <%= " DEV" if Rails.env.development? %></title>
    <% if content_for?(:compact_operator_context) %>
      <meta name="viewport" content="width=device-width, initial-scale=1">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_include_tag "color_theme", "data-turbo-track": "reload" %>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script>
      document.addEventListener('turbo:load', () => {
        document.querySelectorAll('.trace-row').forEach(row => {
          row.addEventListener('click', () => {
            row.nextElementSibling.classList.toggle('expanded');
          });
        });
      });
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload" %>
  </head>

  <body class="<%= 'operator-workspace-page' if content_for?(:compact_operator_context) %>">
    <%= render "layouts/header" %>
    <%= render "shared/flash" %>
    <% page_context = capture do %>
      <% if show_transition_context? %>
        <%= render "shared/transition_context",
                   website: transition_context_website,
                   context: transition_context_summary(transition_context_website),
                   expanded: content_for?(:compact_operator_context) %>
      <% end %>
      <% if !suppress_operator_context_card? && (operator_context = operator_context_payload).present? %>
        <%= render "shared/operator_context_card", context: operator_context, expanded: content_for?(:compact_operator_context) %>
      <% end %>
    <% end %>
    <% if content_for?(:compact_operator_context) && page_context.present? %>
      <details class="operator-context-disclosure">
        <summary>Page context</summary>
        <%= page_context %>
      </details>
    <% else %>
      <%= page_context %>
    <% end %>
    <%= yield %>
  </body>
</html>
