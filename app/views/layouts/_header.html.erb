<% website = transition_context_website %>
<header class="condenser-header" data-condenser-header>
  <div class="condenser-header__main">
    <nav class="condenser-header__links" aria-label="Condenser">
      <%= header_navigation_link "Websites", websites_path, section: "websites", action: "index" %>

      <details class="condenser-header__menu" name="condenser-navigation" data-header-menu>
        <summary>Operations</summary>
        <div class="condenser-header__dropdown">
          <%= header_navigation_link "Monitoring", monitoring_path(seedurl: "all"), section: "monitoring" %>
          <%= header_navigation_link "Transition report", distillator_shadow_report_path,
                section: %w[distillator/shadow_reports distillator/transition_checks distillator/transition_batches distillator/site_transitions] %>
          <%= header_navigation_link "Cache", distillator_cache_index_path, section: "distillator/cache" %>
          <%= link_to "Job queue", sidekiq_web_path %>
          <%= header_navigation_link "Databus", databus_index_path, section: "databus" %>
          <%= header_navigation_link "Messages", messages_path, section: "messages" %>
          <%= header_navigation_link "Test API", test_api_websites_path, section: "websites", action: "test_api" %>
          <% unless website %>
            <hr>
            <%= header_navigation_link "Webpages", webpages_path(seedurl: "all"), section: "webpages" %>
            <%= header_navigation_link "Sources", sources_path(seedurl: "all"), section: "sources" %>
            <%= header_navigation_link "Statements", statements_path(seedurl: "all"), section: "statements" %>
            <%= link_to contextual_console_url do %>
              Console <span aria-hidden="true">↗</span>
            <% end %>
          <% end %>
        </div>
      </details>

      <details class="condenser-header__menu" name="condenser-navigation" data-header-menu>
        <summary>Configuration</summary>
        <div class="condenser-header__dropdown">
          <%= header_navigation_link "Properties", properties_path, section: "properties" %>
          <%= header_navigation_link "Classes", rdfs_classes_path, section: "rdfs_classes" %>
          <%= header_navigation_link "Exceptions", search_exceptions_path, section: "search_exceptions" %>
          <%= header_navigation_link "JSON-LD", jsonld_outputs_path, section: "jsonld_outputs" %>
        </div>
      </details>

      <%= header_navigation_link "DSL Library", dsl_library_entries_path, section: "dsl_library_entries" %>
      <%= header_navigation_link "Options", options_path, section: "options" %>
    </nav>

    <div class="condenser-header__status">
      <% if (wringer_url = wringer_navigation_url) %>
        <%= link_to wringer_url, title: wringer_url do %>
          Wringer · <span data-wringer-reachability-url="<%= wringer_reachability_options_path %>" role="status">Checking…</span>
          <span aria-hidden="true">↗</span>
        <% end %>
      <% else %>
        <span title="Missing or invalid Wringer URL">Wringer · Not configured</span>
      <% end %>
      <% if cookies[:dsl_trace] == "true" %>
        <%= link_to "Trace on", options_path(tab: "trace"), class: "condenser-header__trace" %>
      <% end %>
    </div>
  </div>

  <% if website %>
    <nav class="condenser-header__links condenser-header__website" aria-label="Current website">
      <%= header_navigation_link website.name, website_path(website), section: "websites", action: "show",
            class: "condenser-header__site-name" %>
      <%= header_navigation_link "Webpages", contextual_webpages_path, section: "webpages" %>
      <%= header_navigation_link "Sources", contextual_sources_path, section: "sources" %>
      <%= header_navigation_link "Statements", contextual_statements_path, section: "statements" %>
      <%= link_to contextual_console_url do %>
        Console <span aria-hidden="true">↗</span>
      <% end %>
    </nav>
  <% end %>
</header>

<script>
  jQuery(function () {
    jQuery('#filter').on('change', function () {
      var webpage_id = jQuery(this).val();
      window.location.href = "/websites/" + webpage_id;
    });
  });
</script>
