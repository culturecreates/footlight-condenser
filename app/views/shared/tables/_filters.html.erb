<%
table_key = local_assigns[:table_key]
view_mode = local_assigns[:view_mode]
filters = local_assigns[:filters] || {}
pagination = local_assigns[:pagination] || {}
sort = local_assigns[:sort]
direction = local_assigns[:direction]
seedurl = local_assigns[:seedurl]
source_id = local_assigns[:source_id]
%>

<% if table_key == :webpages %>
  <details class="harmonized-table-filters webpage-advanced-filters" open>
    <summary>Advanced filters</summary>
    <%= form_with url: webpages_path, method: :get, local: true, html: { autocomplete: "off", class: "webpage-advanced-filters-form" } do %>
      <%= hidden_field_tag :seedurl, seedurl if local_assigns[:seedurl].present? %>
      <%= hidden_field_tag :scope, filters[:scope] if filters[:scope].present? %>
      <%= hidden_field_tag :rdfs_class, filters[:rdfs_class] if filters[:rdfs_class].present? && webpages_selected_rdfs_class_id(filters).blank? %>
      <%= hidden_field_tag :sort, sort if sort.present? %>
      <%= hidden_field_tag :direction, direction if direction.present? %>
      <div class="cache-filter-grid">
        <div>
          <%= label_tag :term, "Search" %>
          <%= text_field_tag :term, filters[:term], autocomplete: "off" %>
        </div>
        <div>
          <%= label_tag :language, "Language" %>
          <%= select_tag :language, options_for_select([["Any", ""], ["en", "en"], ["fr", "fr"]], filters[:language]) %>
        </div>
        <div>
          <%= label_tag :url_kind, "URL kind" %>
          <%= select_tag :url_kind, options_for_select([["Any", ""], ["Public source URLs", "public"], ["Internal URIs", "internal"]], filters[:url_kind]) %>
        </div>
        <div>
          <%= label_tag :rdfs_class_id, "Class" %>
          <%= select_tag :rdfs_class_id, options_from_collection_for_select(RdfsClass.order(:name), :id, :name, webpages_selected_rdfs_class_id(filters)), include_blank: "Any" %>
        </div>
        <div>
          <%= label_tag :publishable, "Publishable" %>
          <%= select_tag :publishable, options_for_select([["Any", ""], ["Yes", "true"], ["No", "false"]], filters[:publishable]) %>
        </div>
        <div>
          <%= label_tag :archive_state, "Archive state" %>
          <%= select_tag :archive_state, options_for_select([["Any", ""], ["Active", "active"], ["Archived", "archived"]], filters[:archive_state]) %>
        </div>
      </div>
      <p class="cache-filter-actions">
        <%= submit_tag "Apply filters" %>
        <%= link_to "Reset filters", webpages_path({ seedurl: seedurl.presence, scope: filters[:scope].presence }.compact_blank) %>
      </p>
    <% end %>
  </details>
<% elsif table_key == :properties %>
  <details class="harmonized-table-filters property-advanced-filters" open>
    <summary>Advanced filters</summary>
    <%= form_with url: properties_path, method: :get, local: true, html: { autocomplete: "off", class: "property-advanced-filters-form" } do %>
      <%= hidden_field_tag :sort, sort if sort.present? %>
      <%= hidden_field_tag :direction, direction if direction.present? %>
      <%= hidden_field_tag :per_page, pagination[:per_page] if pagination[:per_page].to_i != ::Properties::IndexQuery::DEFAULT_PER_PAGE %>
      <div class="cache-filter-grid">
        <div>
          <%= label_tag :term, "Search" %>
          <%= text_field_tag :term, filters[:term], autocomplete: "off" %>
        </div>
      </div>
      <p class="cache-filter-actions">
        <%= submit_tag "Apply filters" %>
        <%= link_to "Reset filters", properties_path %>
      </p>
    <% end %>
  </details>
<% elsif table_key == :rdfs_classes %>
  <details class="harmonized-table-filters rdfs-class-advanced-filters" open>
    <summary>Advanced filters</summary>
    <%= form_with url: rdfs_classes_path, method: :get, local: true, html: { autocomplete: "off", class: "rdfs-class-advanced-filters-form" } do %>
      <%= hidden_field_tag :sort, sort if sort.present? %>
      <%= hidden_field_tag :direction, direction if direction.present? %>
      <%= hidden_field_tag :per_page, pagination[:per_page] if pagination[:per_page].to_i != ::RdfsClasses::IndexQuery::DEFAULT_PER_PAGE %>
      <div class="cache-filter-grid">
        <div>
          <%= label_tag :term, "Search" %>
          <%= text_field_tag :term, filters[:term], autocomplete: "off" %>
        </div>
      </div>
      <p class="cache-filter-actions">
        <%= submit_tag "Apply filters" %>
        <%= link_to "Reset filters", rdfs_classes_path %>
      </p>
    <% end %>
  </details>
<% elsif table_key == :statements %>
  <details class="harmonized-table-filters statement-advanced-filters" open>
    <summary>Advanced filters</summary>
    <%= form_with url: statements_path, method: :get, local: true, html: { autocomplete: "off", class: "statement-advanced-filters-form" } do %>
      <%= hidden_field_tag :sort, sort if sort.present? %>
      <%= hidden_field_tag :direction, direction if direction.present? %>
      <%= hidden_field_tag :per_page, pagination[:per_page] if pagination[:per_page].to_i != ::Statements::IndexQuery::DEFAULT_PER_PAGE %>
      <div class="source-filter-grid">
        <div>
          <%= label_tag :seedurl, "Seedurl" %>
          <%= text_field_tag :seedurl, filters[:seedurl], autocomplete: "off" %>
        </div>
        <div>
          <%= label_tag :rdf_uri, "Rdf uri" %>
          <%= text_field_tag :rdf_uri, filters[:rdf_uri], autocomplete: "off" %>
        </div>
        <div>
          <%= label_tag :prop, "Property" %>
          <%= text_field_tag :prop, filters[:prop], autocomplete: "off" %>
        </div>
        <div>
          <%= label_tag :source, "Source" %>
          <%= text_field_tag :source, filters[:source], autocomplete: "off" %>
        </div>
        <div>
          <%= label_tag :cache, "Cache" %>
          <%= text_field_tag :cache, filters[:cache], autocomplete: "off" %>
        </div>
        <div>
          <%= label_tag :status, "Status" %>
          <%= select_tag :status, options_for_select([["Any", ""], ["initial", "initial"], ["missing", "missing"], ["ok", "ok"], ["problem", "problem"], ["updated", "updated"]], filters[:status]) %>
        </div>
        <div>
          <%= label_tag :manual, "Manual" %>
          <%= select_tag :manual, options_for_select([["Any", ""], ["true", "true"], ["false", "false"]], filters[:manual]) %>
        </div>
        <div>
          <%= label_tag :selected, "Selected source" %>
          <%= select_tag :selected, options_for_select([["Any", ""], ["true", "true"], ["false", "false"]], filters[:selected]) %>
        </div>
        <div>
          <%= label_tag :selected_individual, "Selected individual" %>
          <%= select_tag :selected_individual, options_for_select([["Any", ""], ["true", "true"], ["false", "false"]], filters[:selected_individual]) %>
        </div>
      </div>
      <p class="sources-filter-actions">
        <%= submit_tag "Apply filters" %>
        <%= link_to "Reset filters", statements_path %>
      </p>
    <% end %>
  </details>
<% elsif table_key == :events %>
  <details class="harmonized-table-filters event-advanced-filters" open>
    <summary>Advanced filters</summary>
    <%= form_with url: website_events_path(seedurl: seedurl), method: :get, local: true, html: { autocomplete: "off", class: "event-advanced-filters-form" } do %>
