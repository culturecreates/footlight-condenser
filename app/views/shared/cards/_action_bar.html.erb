<div class="cache-actions harmonized-card-actions">
  <% Array(groups).each do |group| %>
    <div class="cache-action-group">
      <strong><%= group[:title] %></strong>
      <% Array(group[:links]).each do |link| %>
        <%= link_to link[:label], link[:url], link[:options] || {} %>
      <% end %>
    </div>
  <% end %>
</div>
