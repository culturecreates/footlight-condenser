<h1>Transition Report Detail</h1>

<p class="cache-page-note">This page is read-only. It reflects the current rollout state without triggering fetches.</p>
<p class="cache-page-note">Transition checks are run by batch job. This page displays the latest result.</p>

<section id="transition-report-summary" class="website-rollout-panel">
  <h2>Summary</h2>
  <p><strong>Is this site ready?</strong> <%= shadow_report_decision_label(@detail.decision) %></p>
  <p><strong>What is blocking it?</strong> <%= @detail.primary_blocker&.headline.presence || "No blocking issue is currently recorded." %></p>
  <p><strong>When was it checked?</strong> <%= shadow_report_timestamp(@detail.summary.latest_refresh || @detail.summary.latest_successful_refresh) %></p>
  <p><strong>How many pages were checked?</strong> <%= shadow_report_checked_pages_summary(@detail.checked_scope) %></p>
  <p><strong>Links:</strong>
    <%= link_to "Website batch jobs", website_path(@website, anchor: "website-batch-jobs-transition") %> |
    <%= link_to "Inspect publishable event pages", webpages_path(seedurl: @website.seedurl) %> |
    <%= link_to "Open cache diagnostics", website_cache_diagnostics_path(@website) %>
  </p>
</section>

<section class="website-rollout-panel">
  <h2>Decision</h2>
  <p><strong>Decision:</strong> <%= shadow_report_decision_label(@detail.decision) %></p>
  <p><strong>Safety:</strong> <%= @detail.transition_status.safety.to_s.humanize %></p>
  <p><strong>Confidence:</strong> <%= @detail.transition_status.confidence.to_s.humanize %></p>
  <p><strong>Why:</strong> <%= @detail.decision[:why].first %></p>
  <p><strong>Recommended action:</strong> <%= @detail.decision[:recommended_action] %></p>
  <ul>
    <% @detail.transition_status.checks.each do |check| %>
      <li><%= shadow_report_check_icon(check[:state]) %> <strong><%= check[:label] %></strong> — <%= shadow_report_check_label(check[:state]) %></li>
    <% end %>
  </ul>
</section>

<section class="website-rollout-panel">
  <h2>Main blocker</h2>
  <p><strong><%= shadow_report_primary_blocker_heading(@detail.primary_blocker) %></strong></p>
  <% shadow_report_main_blocker_lines(@detail).each do |line| %>
    <p><%= line %></p>
  <% end %>
  <% blocking_groups = shadow_report_statement_failure_groups(@detail, severity: :blocker) %>
  <% warning_groups = shadow_report_statement_failure_groups(@detail, severity: :warning) %>
  <% if blocking_groups.any? || warning_groups.any? %>
    <h3>Statement failure summary</h3>
    <% if blocking_groups.any? %>
      <p><strong>Blocking statement failures</strong></p>
      <ul>
        <% blocking_groups.each do |group| %>
          <li>
            <%= [group[:reason], group[:source], "#{group[:count]} affected"].compact.join(" - ") %>
            <% if group[:statement_ids].any? %>
              <details>
                <summary>Raw statement IDs</summary>
                <p><%= group[:statement_ids].join(", ") %></p>
              </details>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if warning_groups.any? %>
      <p><strong>Optional statement warnings</strong></p>
      <ul>
        <% warning_groups.each do |group| %>
          <li>
            <%= [group[:reason], group[:source], "#{group[:count]} affected"].compact.join(" - ") %>
            <% if group[:statement_ids].any? %>
              <details>
                <summary>Raw statement IDs</summary>
                <p><%= group[:statement_ids].join(", ") %></p>
              </details>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
  <% blocker_links = shadow_report_primary_blocker_links(@detail) %>
  <% if blocker_links.any? %>
    <p><strong>Next diagnostic links:</strong> <%= safe_join(blocker_links, " | ") %></p>
  <% end %>
  <p><%= link_to "Open website batch jobs", website_path(@website, anchor: "website-batch-jobs-transition") %></p>
</section>

<section class="website-rollout-panel">
  <h2>Representative URL Matrix</h2>
  <% if @detail.url_matrix.any? %>
    <table class="cache-table cache-compare-table">
      <thead>
        <tr>
          <th>URL</th>
          <th>Condenser fetch result</th>
          <th>Legacy lookup result</th>
          <th>Cache comparison result</th>
          <th>Statement check result</th>
          <th>Export impact</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @detail.url_matrix.each do |row| %>
          <tr>
            <td><%= external_website_link(row[:url]) %></td>
            <td>
              <%= row[:condenser_fetch_result] %>
              <% if shadow_report_matrix_reason(row, :fetch_reason).present? %>
                <div class="sources-secondary-text"><%= shadow_report_matrix_reason(row, :fetch_reason) %></div>
              <% end %>
            </td>
            <td>
              <%= row[:legacy_lookup_result] %>
              <% if shadow_report_matrix_reason(row, :legacy_lookup_reason).present? %>
                <div class="sources-secondary-text"><%= shadow_report_matrix_reason(row, :legacy_lookup_reason) %></div>
              <% end %>
            </td>
            <td>
              <%= row[:cache_comparison_result] %>
              <% if shadow_report_matrix_reason(row, :cache_compare_reason).present? %>
                <div class="sources-secondary-text"><%= shadow_report_matrix_reason(row, :cache_compare_reason) %></div>
              <% end %>
            </td>
            <td>
              <%= row[:statement_check_result] %>
              <% if shadow_report_matrix_reason(row, :statement_reason).present? %>
                <div class="sources-secondary-text"><%= shadow_report_matrix_reason(row, :statement_reason) %></div>
              <% end %>
            </td>
            <td>
              <%= row[:export_impact] %>
              <% if shadow_report_matrix_reason(row, :export_reason).present? %>
                <div class="sources-secondary-text"><%= shadow_report_matrix_reason(row, :export_reason) %></div>
              <% end %>
            </td>
            <td><%= shadow_report_url_matrix_actions(row, @website) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No sampled representative URLs were recorded.</p>
  <% end %>
</section>

<section class="website-rollout-panel">
  <h2>Checked scope</h2>
  <ul>
    <% shadow_report_scope_lines(@detail.checked_scope).each do |line| %>
      <li><%= line %></li>
    <% end %>
  </ul>
  <% if shadow_report_scope_warning(@detail.checked_scope).present? %>
    <p><%= shadow_report_scope_warning(@detail.checked_scope) %></p>
  <% end %>
</section>

<details class="website-rollout-panel">
  <summary>Audit</summary>
  <p><strong>Website:</strong> <%= @website.name %></p>
  <p><strong>Seedurl:</strong> <%= @website.seedurl %></p>
  <p><strong>Cohort:</strong> <%= @detail.summary.cohort_label.presence || "Other" %></p>
  <p><strong>Current rollout mode:</strong> <%= Distillator::RolloutCopy.label(@website.distillator_mode) %></p>
  <p><strong>Production backend:</strong> <%= shadow_report_production_backend_label(@detail.summary) %></p>
  <p><strong>Comparison policy:</strong> <%= @detail.transition_status.comparison_policy.to_s.humanize %> mode</p>
  <p><strong>Latest attempt:</strong> <%= shadow_report_timestamp(@detail.summary.latest_refresh) %></p>
  <p><strong>Latest successful refresh:</strong> <%= shadow_report_timestamp(@detail.summary.latest_successful_refresh) %></p>
  <p><strong>Health:</strong> <%= @detail.summary.health_summary %></p>
  <p><strong>Issue:</strong> <%= @detail.summary.issue_key.presence || "None" %></p>
  <p><strong>Cache links:</strong> <%= shadow_report_cache_diagnostic_links(@detail.summary) %></p>
  <h3>Check explanations</h3>
  <% @detail.transition_evidence_explanations.each do |explanation| %>
    <details class="website-rollout-panel">
      <summary><%= explanation.check %> details</summary>
      <p><strong>State:</strong> <%= explanation.state %></p>
      <p><strong>Headline:</strong> <%= explanation.headline %></p>
      <% if explanation.details.any? %>
        <ul>
          <% explanation.details.each do |line| %>
            <li><%= line %></li>
          <% end %>
        </ul>
      <% end %>
      <p><strong>Next action:</strong> <%= explanation.next_action %></p>
      <% if explanation.links.any? %>
        <p><strong>Links:</strong> <%= safe_join(shadow_report_explanation_links(explanation, @website, detail: @detail), " | ") %></p>
      <% end %>
    </details>
  <% end %>
  <h3>Recent rollout events</h3>
  <% if @detail.recent_rollout_events.any? %>
    <ul>
      <% @detail.recent_rollout_events.each do |event| %>
        <li>
          <%= [event.from_mode.presence || "unknown", "to", event.to_mode, event.created_at].join(" ") %>
          <% if event.readiness_snapshot["warnings"].present? %>
            | warnings: <%= Array(event.readiness_snapshot["warnings"]).join(", ") %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No rollout events recorded yet.</p>
  <% end %>

  <% if @detail.transition_status.review_activation_eligible %>
    <h3>Review checklist</h3>
    <% sampled_webpages = shadow_report_sampled_webpages(@detail) %>
    <% first_sample = sampled_webpages.first %>
    <ul>
      <li><%= link_to "Open source website", first_sample[:links].find { |link| link[:label] == "Source website" }[:url], target: "_blank", rel: "noopener" if first_sample.present? && first_sample[:links].any? { |link| link[:label] == "Source website" } %></li>
      <li><%= link_to "Open compare page", first_sample[:links].find { |link| link[:label] == "Compare" }[:url] if first_sample.present? && first_sample[:links].any? { |link| link[:label] == "Compare" } %></li>
      <li><%= link_to "Open active cache", first_sample[:links].find { |link| link[:label] == "Open active cache" }[:url] if first_sample.present? && first_sample[:links].any? { |link| link[:label] == "Open active cache" } %></li>
      <li><%= link_to "Open Condenser cache", first_sample[:links].find { |link| link[:label] == "Open Condenser cache" }[:url] if first_sample.present? && first_sample[:links].any? { |link| link[:label] == "Open Condenser cache" } %></li>
      <li><%= link_to "Open webpage record", first_sample[:links].find { |link| link[:label] == "Webpage record" }[:url] if first_sample.present? && first_sample[:links].any? { |link| link[:label] == "Webpage record" } %></li>
      <li>Compare title, date, location, and ticket link.</li>
      <li><%= link_to "Check statements page", statements_path(seedurl: @website.seedurl) %></li>
      <li>Check JSON-LD/export if relevant.</li>
      <li>Activate after review, with reason.</li>
    </ul>
  <% end %>

  <h3>Transition evidence</h3>
  <table class="harmonized-table-shell">
    <thead>
      <tr>
        <th>Check</th>
        <th>Status</th>
        <th>Checked at</th>
        <th>URL used</th>
        <th>Headline</th>
        <th>Relevant fields</th>
        <th>Next action</th>
      </tr>
    </thead>
    <tbody>
      <% shadow_report_transition_evidence_rows(@detail).each do |row| %>
        <tr>
          <td><%= row[:label] %></td>
          <td><%= row[:status] %></td>
          <td><%= row[:checked_at] %></td>
          <td><%= external_website_link(row[:url], max: 120) %></td>
          <td><%= row[:headline] %></td>
          <td>
            <% if row[:details].any? %>
              <details>
                <summary>Show details</summary>
                <ul>
                  <% row[:details].each do |detail| %>
                    <li><%= detail %></li>
                  <% end %>
                </ul>
              </details>
            <% else %>
              Recorded
            <% end %>
          </td>
          <td>
            <p><%= row[:next_action] %></p>
            <% if row[:links].any? %>
              <p><%= safe_join(row[:links], " | ") %></p>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</details>

<% if @website.distillator_mode == "active" %>
  <section class="website-rollout-panel">
    <h2>Rollback path</h2>
    <p>Set rollout mode to Legacy in website options.</p>
    <p>Wringer becomes production backend.</p>
    <p>Condenser cache remains available for inspection.</p>
  </section>
<% end %>

<p><%= link_to "Back to Transition Report", distillator_shadow_report_path %></p>
