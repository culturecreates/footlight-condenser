<h1>Cache Comparison</h1>

<p class="cache-page-notice cache-compare-warning">Read-only comparison only. No cache refresh was performed. Legacy data may be read from the configured Wringer cache endpoint.</p>

<p><strong>URI:</strong> <span class="cache-normalized-url"><%= external_website_link(@comparison[:uri]) %></span></p>
<p><strong>URI key:</strong> <span class="cache-uri-key"><%= @comparison[:uri_key] || "Unavailable" %></span></p>
<p><strong>Comparison policy:</strong> <%= @comparison[:comparison_policy].to_s.humanize %> mode</p>
<p>
  <%= link_to "Operator mode", condenser_cache_compare_path(uri: @comparison[:uri], comparison_policy: "operator") %> |
  <%= link_to "Strict mode", condenser_cache_compare_path(uri: @comparison[:uri], comparison_policy: "strict") %>
</p>

<section class="website-rollout-panel">
  <h2>Summary</h2>
  <p><strong>Outcome:</strong> <%= cache_compare_outcome_label(@comparison[:summary]) %></p>
  <p><strong>Main reason:</strong> <%= @comparison.dig(:summary, :primary_reason) %></p>
  <p><strong>Recommended action:</strong>
    <% case @comparison.dig(:summary, :outcome).to_s %>
    <% when "blocked" %>
      Review the safety blockers before activating.
    <% when "review" %>
      Review the grouped differences, then decide whether the site is safe to activate.
    <% when "ready_with_metadata_notes" %>
      Metadata notes only. Activation can proceed when the rest of the evidence is ready.
    <% else %>
      No comparison action is needed right now.
    <% end %>
  </p>
</section>

<section class="website-rollout-panel">
  <h2>Key evidence</h2>
  <p><strong>Legacy source:</strong> <%= @comparison[:legacy_source] %></p>
  <p><strong>Legacy lookup error:</strong> <%= @comparison[:legacy_lookup_error] || "None" %></p>
  <p><strong>Condenser source:</strong> <%= @comparison[:condenser_source] %></p>
  <p><strong>Legacy cache missing:</strong> <%= @comparison.dig(:missing, :legacy) %></p>
  <p><strong>Condenser cache missing:</strong> <%= @comparison.dig(:missing, :condenser) %></p>
  <p><strong>HTTP codes:</strong> legacy <%= @comparison.dig(:legacy_cache, :http_code).presence || "unknown" %> / condenser <%= @comparison.dig(:condenser_cache, :http_code).presence || "unknown" %></p>
  <p><strong>Title match:</strong> <%= @comparison.dig(:diffs, :title, :same) ? "yes" : "no" %></p>
  <p><strong>Content success:</strong> legacy <%= @comparison.dig(:legacy_cache, :content_success).inspect %> / condenser <%= @comparison.dig(:condenser_cache, :content_success).inspect %></p>
  <p><strong>Transport success:</strong> legacy <%= @comparison.dig(:legacy_cache, :transport_success).inspect %> / condenser <%= @comparison.dig(:condenser_cache, :transport_success).inspect %></p>
  <p><strong>Latest refresh:</strong> legacy <%= @comparison.dig(:legacy_cache, :successful_refresh).presence || "unknown" %> / condenser <%= @comparison.dig(:condenser_cache, :successful_refresh).presence || "unknown" %></p>
  <p><strong>Links:</strong>
    <%= safe_join(cache_inspection_links(@comparison[:uri]).map { |link| link_to(link[:label], link[:url]) }, " | ") %>
  </p>
</section>

<section class="website-rollout-panel">
  <h2>Differences grouped by importance</h2>
  <% grouped_diffs = {
    "Safety blockers" => :blocking_regression,
    "Review-needed differences" => :review_needed,
    "Metadata-only differences" => :metadata_only,
    "Improvements" => :distillator_improvement
  } %>
  <% grouped_diffs.each do |label, classification| %>
    <% rows = @comparison[:diffs].select { |_field, diff| diff[:classification] == classification } %>
    <% next if rows.empty? && label == "Metadata-only differences" %>
    <h3><%= label %></h3>
    <% if rows.empty? %>
      <p>None.</p>
    <% else %>
      <table class="cache-table cache-compare-table">
        <thead>
          <tr>
            <th>Field</th>
            <th>Legacy</th>
            <th>Condenser</th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |field, diff| %>
            <tr>
              <td><%= field %></td>
              <td><pre class="cache-json-block"><%= JSON.pretty_generate(diff[:legacy]) rescue diff[:legacy].inspect %></pre></td>
              <td><pre class="cache-json-block"><%= JSON.pretty_generate(diff[:condenser]) rescue diff[:condenser].inspect %></pre></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
</section>

<details class="cache-detail-details">
  <summary>Detailed comparison</summary>
  <table class="cache-table cache-compare-table">
    <thead>
      <tr>
        <th>Field</th>
        <th>Same?</th>
        <th>Status</th>
        <th>Legacy</th>
        <th>Condenser</th>
      </tr>
    </thead>
    <tbody>
      <% @comparison[:diffs].each do |field, diff| %>
        <tr class="<%= diff[:same] ? 'cache-compare-same' : 'cache-compare-different' %>">
          <td><%= field %></td>
          <td><%= diff[:same] %></td>
          <td><%= diff[:classification] %></td>
          <td><pre class="cache-json-block"><%= JSON.pretty_generate(diff[:legacy]) rescue diff[:legacy].inspect %></pre></td>
          <td><pre class="cache-json-block"><%= JSON.pretty_generate(diff[:condenser]) rescue diff[:condenser].inspect %></pre></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</details>

<details class="cache-detail-details">
  <summary>Raw payloads</summary>
  <div class="cache-detail-card">
    <h3>Legacy payload</h3>
    <pre class="cache-json-block"><%= JSON.pretty_generate(@comparison[:legacy_cache]) rescue @comparison[:legacy_cache].inspect %></pre>
    <h3>Condenser payload</h3>
    <pre class="cache-json-block"><%= JSON.pretty_generate(@comparison[:condenser_cache]) rescue @comparison[:condenser_cache].inspect %></pre>
  </div>
</details>
