<% if item.status == "running" %>
  <% if item.cancel_requested_at? %>
    <p class="transition-secondary">Cancellation requested. The current operation may need to finish before the transition stops.</p>
  <% else %>
    <%= button_to "Cancel current transition",
          cancel_distillator_site_transition_path(item, from: local_assigns[:from]), method: :patch,
          id: "workflow-cancel-#{item.id}" %>
  <% end %>
<% end %>
