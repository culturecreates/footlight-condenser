
<h1>Properties</h1>

<%= render "shared/tables/table_shell",
           table_key: :properties,
           records: @properties,
           row_partial: "properties/harmonized_row",
           row_name: :property,
           headers: @property_table_headers,
           filters: @filters,
           pagination: @pagination,
           sort: @sort,
           direction: @direction,
           sortable_filters: @sortable_filters,
           table_css_class: "cache-table properties-table",
           render_filters: true,
           empty_message: "No properties match the current filters." %>

<br>

<%= link_to 'New Property', new_property_path %>
