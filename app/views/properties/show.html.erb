
<%= render "shared/cards/card_grid",
           cards: [
             {
               title: @property.label,
               rows: [
                 { label: "Value datatype", value: @property.value_datatype },
                 { label: "Expected Class", value: @property.expected_class },
                 { label: "Uri", value: @property.uri },
                 { label: "Rdfs class", value: "#{@property.rdfs_class.name} (#{@property.rdfs_class.id})" }
               ],
               actions: [
                 {
                   title: "Actions",
                   links: [
                     { label: "Edit", url: edit_property_path(@property) },
                     { label: "Back", url: properties_path }
                   ]
                 }
               ]
             }
           ],
           variant: :record,
           css_class: "property-detail-cards" %>
