<tr>
  <td><%= property.id %></td>
  <td><%= property.rdfs_class&.name %></td>
  <td><%= property.label %></td>
  <td><%= property.value_datatype %></td>
  <td><%= property.expected_class %></td>
  <td><%= property.uri %></td>
  <td>
    <%= link_to "Show", property %>
    <%= link_to "Edit", edit_property_path(property) %>
    <%= link_to "Destroy", property, method: :delete, data: { confirm: "Are you sure?", turbo: false } %>
  </td>
</tr>
