<section class="options-form">
  <h2>Options</h2>
  <nav class="options-tabs" aria-label="Options subjects">
    <% OptionsController::TABS.each do |tab, label| %>
      <%= link_to label, options_path(contextual_seedurl_params.merge(tab: tab)),
                  aria: { current: ("page" if @tab == tab) } %>
    <% end %>
  </nav>
  <div class="options-panel" id="options-<%= @tab %>">
    <%= render @tab %>
  </div>
</section>
