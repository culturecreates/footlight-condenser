<h1>Places for <%= params[:seedurl] %></h1>

<%= render "shared/tables/table_shell",
           table_key: :places,
           records: @places,
           row_partial: "places/harmonized_row",
           row_name: :place_row,
           headers: @place_table_headers,
           filters: @filters,
           pagination: @pagination,
           sort: @sort,
           direction: @direction,
           sortable_filters: @sortable_filters.merge(seedurl: params[:seedurl]),
           table_css_class: "cache-table places-table",
           empty_message: "No places match the current scope." %>
