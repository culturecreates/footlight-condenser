<tr>
  <td>
    <strong><%= source.id %></strong>
    <div class="sources-secondary-text"><%= source.website&.seedurl.presence || "No website" %></div>
  </td>

  <td>
    <strong><%= source_property_name(source) %></strong>
    <% if source_property_context(source).present? %>
      <div class="sources-secondary-text"><%= source_property_context(source) %></div>
    <% end %>
  </td>

  <td>
    <strong><%= source_label_text(source) %></strong>
    <div class="sources-secondary-text"><%= source.language.presence || "Language-independent" %></div>
  </td>

  <td class="source-algorithm-cell">
    <pre class="sources-algorithm-preview"><%= source_algorithm_text(source) %></pre>
  </td>

  <td>
    <strong><%= source_boolean_text(source.selected?) %></strong>
    <div class="sources-secondary-text"><%= source.selected_by.presence || "No selector recorded" %></div>
  </td>

  <td>
    <strong><%= source_boolean_text(source.render_js?) %></strong>
  </td>

  <td>
    <strong><%= source_boolean_text(source.auto_review?) %></strong>
  </td>

  <td>
    <strong><%= source_last_test_summary(source) %></strong>
    <div class="sources-secondary-text"><%= source_last_test_detail(source) %></div>
  </td>

  <td class="sources-actions-cell">
    <div class="cache-action-group">
      <strong>Actions</strong>
      <%= link_to "Show", source_path(source, from: params[:from], seedurl: params[:seedurl]) %>
      <%= link_to "Edit", edit_source_path(source) %>
      <%= source_inline_test_action(source) %>
      <%= source_inline_trace_action(source) %>
    </div>

    <details class="sources-row-details">
      <summary>More</summary>

      <div class="cache-action-group">
        <strong>Secondary actions</strong>
        <%= source_more_actions(source) %>
      </div>

      <div class="cache-action-group">
        <strong>Source details</strong>
        <dl class="sources-detail-list">
          <% source_metadata_pairs(source).each do |label, value| %>
            <dt><%= label %></dt>
            <dd><%= value %></dd>
          <% end %>
        </dl>
      </div>

      <div class="cache-action-group">
        <strong>Compatibility links</strong>
        <% if source_cache_rollout_badge(source).present? %>
          <p><%= source_cache_rollout_badge(source) %></p>
        <% end %>
        <p class="sources-secondary-text"><%= source_cache_note(source) %></p>
      </div>
    </details>
  </td>
</tr>
