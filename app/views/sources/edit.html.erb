<h1>Editing Source</h1>

<%= render 'form', source: @source %>

<%= link_to 'Show', @source %> |
<%= link_to 'Back', sources_path %>
<% instructions = render(partial: 'instructions') %>
<% if instructions.to_s.strip.present? %>
  <details class="source-edit-instructions">
    <summary>Instructions</summary>
    <%= instructions %>
  </details>
<% end %>
