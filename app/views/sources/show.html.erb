<p id="notice"><%= notice %></p>

<h1>Source <%= @source.id %></h1>

<%
  primary_summary_pairs = [
    ["Website", @source.website.present? ? link_to(@source.website.seedurl, website_path(@source.website)) : "No website"],
    ["Property", source_property_name(@source)],
    ["Label", source_label_text(@source)],
    ["Language", @source.language.presence || "Language-independent"],
    ["Selected", source_boolean_text(@source.selected?)],
    ["Render JS", source_boolean_text(@source.render_js?)],
    ["Auto review", source_boolean_text(@source.auto_review?)]
  ]
  usage_context_present = source_latest_statement_for_display(@source).present? || source_statement_count(@source).positive?
%>

<section class="source-show-section source-primary-summary">
  <dl class="sources-show-list">
    <% primary_summary_pairs.each do |label, value| %>
      <dt><%= label %></dt>
      <dd><%= value %></dd>
    <% end %>
  </dl>
</section>

<section class="source-show-section source-primary-actions">
  <h2>Primary actions</h2>
  <p>
    <%= source_show_test_action(@source) %> |
    <%= link_to "Edit source", edit_source_path(@source) %> |
    <%= link_to "Report", source_reports_path(source_id: @source.id) %> |
    <%= link_to "Back", source_show_back_path(@source) %>
  </p>
</section>

<section class="source-show-section source-algorithm-dsl">
  <h2>Raw extraction DSL</h2>
  <pre class="sources-show-pre"><%= source_algorithm_text(@source) %></pre>
</section>

<% if usage_context_present %>
  <details class="source-show-details source-show-usage">
    <summary>Latest result</summary>
    <div class="source-show-section">
      <dl class="sources-show-list">
        <% source_latest_result_pairs(@source).each do |label, value| %>
          <dt><%= label %></dt>
          <dd><%= value %></dd>
        <% end %>
        <dt>Statement count</dt>
        <dd><%= source_statement_count(@source) %></dd>
      </dl>

      <p><strong>Latest statement cache / value</strong></p>
      <pre class="sources-show-pre"><%= source_latest_statement_cache_text(@source) %></pre>
    </div>
  </details>
<% end %>

<% diagnostics_pairs = source_diagnostics_pairs(@source) %>
<% if diagnostics_pairs.any? %>
  <details class="source-show-details">
    <summary>Diagnostics</summary>
    <div class="source-show-section">
      <dl class="sources-detail-list">
        <% diagnostics_pairs.each do |label, value| %>
          <dt><%= label %></dt>
          <dd><%= value %></dd>
        <% end %>
      </dl>
    </div>
  </details>
<% end %>

<details class="source-show-details">
  <summary>Compatibility / rollout</summary>
  <div class="source-show-section">
    <p><%= source_status_badge(@source) %></p>

    <% if source_cache_rollout_badge(@source).present? %>
      <p><%= source_cache_rollout_badge(@source) %></p>
    <% end %>

    <p class="sources-secondary-text"><%= source_rollout_explanation(@source) %></p>
    <p class="sources-secondary-text"><%= source_cache_note(@source) %></p>

    <dl class="sources-show-list">
      <dt>Website default</dt>
      <dd><%= source_boolean_text(@source.selected?) %></dd>
      <dt>Selected by</dt>
      <dd><%= @source.selected_by.presence || "Not recorded" %></dd>
      <dt>Fetch strategy</dt>
      <dd><%= source_fetch_strategy(@source)[:label] %></dd>
      <dt>Last test</dt>
      <dd><%= source_last_test_summary(@source) %></dd>
      <dt>Last test detail</dt>
      <dd><%= source_last_test_detail(@source) %></dd>
    </dl>

    <div class="sources-impact-panel">
      <p><strong>Activation impact:</strong> <%= source_activation_impact(@source) %></p>
      <p class="sources-secondary-text"><%= source_activation_detail(@source) %></p>
    </div>

    <%= source_diagnostics_actions(@source) %>
  </div>
</details>

<% danger_zone_actions = source_danger_zone_actions(@source) %>
<% if danger_zone_actions.present? %>
  <details class="source-show-details source-danger-zone">
    <summary>Danger zone</summary>
    <div class="source-show-section">
      <%= danger_zone_actions %>
    </div>
  </details>
<% end %>
