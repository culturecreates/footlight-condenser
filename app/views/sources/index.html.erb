<h1>Sources</h1>

<p class="sources-page-note">
  Review source templates, narrow the list with quick filters, and open testing or cache tools without exposing raw DSL by default.
</p>

<%= render "shared/tables/toolbar",
           table_key: :sources,
           quick_filters: @source_quick_filters,
           seedurl: @seedurl %>

<%= render "shared/tables/table_shell",
           table_key: :sources,
           records: @sources,
           row_partial: "sources/harmonized_row",
           row_name: :source,
           headers: @source_table_headers,
           filters: @filters,
           pagination: @pagination,
           sort: @sort,
           direction: @direction,
           sortable_filters: @sortable_filters,
           table_css_class: "cache-table sources-table",
           seedurl: @seedurl,
           empty_message: "No sources match the current filters." %>

<br>

<% @rdfs_classes.each do |rdfs_class| %>
  <%= link_to "New #{rdfs_class.name} Source", new_source_path(rdfs_class_id: rdfs_class.id) %>
  <%= '|' if  rdfs_class != @rdfs_classes.last %>
<% end %>

<br><br>
Added sources from website: 
<% if @website_id %>
  <%= form_tag(copy_sources_path(to_website_id: @website_id )) do -%>
    <%= select_tag "from_website_id", options_from_collection_for_select(list_of_websites, "id", "seedurl") %> 
    <div><%= submit_tag('Copy', class: "button") %></div>
  <% end -%>
<% else %>
  Please select a website first.
<% end %>  
